<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="traction_wheel_radius"  value="0.10"/>
  <xacro:property name="traction_wheel_width"   value="0.05"/>
  <xacro:property name="traction_track_width"   value="0.36"/>
  <xacro:property name="chassis_height"         value="0.19"/>
  <xacro:property name="trolley_wheel_radius"   value="0.044"/>
  <xacro:property name="eps"                    value="0.002"/>
  <xacro:property name="wheel_mass"             value="1.5"/>

  <xacro:macro name="drive_wheel" params="name y_reflect">
    <link name="${name}_link">
      <visual>
        <geometry>
          <cylinder radius="${traction_wheel_radius}" length="${traction_wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <material name="orange"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${traction_wheel_radius}" length="${traction_wheel_width}"/>
        </geometry>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
      </collision>
      <xacro:cylinder_inertia m="${wheel_mass}"
                               r="${traction_wheel_radius}"
                               h="${traction_wheel_width}"/>
    </link>

    <!-- exact bcr_bot formula for wheel z -->
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_link"/>
      <origin xyz="0 ${y_reflect * traction_track_width/2} ${-(chassis_height/2 + 2*trolley_wheel_radius + eps - traction_wheel_radius)}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${name}_link">
      <mu1>5.0</mu1>
      <mu2>5.0</mu2>
      <material>Gazebo/Orange</material>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel name="left_wheel"  y_reflect=" 1"/>
  <xacro:drive_wheel name="right_wheel" y_reflect="-1"/>

</robot>
