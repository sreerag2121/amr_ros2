<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- scaled down from bcr_bot proportions -->
  <xacro:property name="chassis_length"       value="0.60"/>
  <xacro:property name="chassis_width"        value="0.40"/>
  <xacro:property name="chassis_height"       value="0.19"/>
  <xacro:property name="chassis_mass"         value="12.0"/>
  <xacro:property name="traction_wheel_radius" value="0.10"/>
  <xacro:property name="trolley_wheel_radius"  value="0.044"/>
  <xacro:property name="trolley_track_width"   value="0.36"/>
  <xacro:property name="eps"                   value="0.002"/>
  <xacro:property name="castor_mass"           value="0.1"/>

  <material name="dark_grey">
    <color rgba="0.18 0.32 0.45 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.4 0.0 1.0"/>
  </material>
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <link name="base_footprint"/>
  <link name="base_link"/>

  <!-- z = chassis_height/2 + 2*trolley_wheel_radius + eps = 0.095 + 0.088 + 0.002 = 0.185 -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.185" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${chassis_mass}"
                       x="${chassis_length}"
                       y="${chassis_width}"
                       z="${chassis_height}"/>
  </link>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <gazebo reference="chassis_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- ═══════════════════════════════════
       CASTOR (TROLLEY) WHEEL MACRO
       exact bcr_bot formula:
       z = -(trolley_wheel_radius + chassis_height/2)
  ═══════════════════════════════════ -->
  <xacro:macro name="castor_wheel" params="name x y">
    <link name="${name}_link">
      <visual>
        <geometry><sphere radius="${trolley_wheel_radius}"/></geometry>
        <material name="black"/>
      </visual>
      <collision>
        <geometry><sphere radius="${trolley_wheel_radius}"/></geometry>
      </collision>
      <xacro:sphere_inertia m="${castor_mass}" r="${trolley_wheel_radius}"/>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="chassis_link"/>
      <child link="${name}_link"/>
      <origin xyz="${x} ${y} ${-(trolley_wheel_radius + chassis_height/2)}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="${name}_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <material>Gazebo/Black</material>
    </gazebo>
  </xacro:macro>

  <!-- front and rear castors -->
  <xacro:castor_wheel name="front_left_castor"  x=" ${chassis_length/2 - 0.05}"  y=" ${trolley_track_width/2}"/>
  <xacro:castor_wheel name="front_right_castor" x=" ${chassis_length/2 - 0.05}"  y="-${trolley_track_width/2}"/>
  <xacro:castor_wheel name="rear_left_castor"   x="-${chassis_length/2 - 0.05}"  y=" ${trolley_track_width/2}"/>
  <xacro:castor_wheel name="rear_right_castor"  x="-${chassis_length/2 - 0.05}"  y="-${trolley_track_width/2}"/>

</robot>
