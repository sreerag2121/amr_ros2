    <!-- ========================================================
         LIFTABLE SHELF CARTS (DYNAMIC — can be picked up by robot)
         =======================================================
         These are mobile carts with 4 thin legs and a flat top platform.
         The robot drives underneath, then uses lift_joint to raise the tray
         which pushes against the cart platform, lifting the entire cart.

         Cart dimensions:
         - Platform: 0.50m x 0.30m x 0.02m (fits within rack footprint)
         - 4 legs: 0.03m diameter cylinders, 0.28m tall
         - Platform bottom at z = 0.28m (just above the robot's lift tray at rest ~0.29m)
         - When lift_joint extends 0.07m, tray reaches ~0.36m, lifting cart off ground

         These are placed in the aisles between racks for pickup.
    ======================================================== -->

    <!-- Cart 1: In aisle between row A and B -->
    <model name="cart_1">
      <pose>-6 -4.5 0 0 0 0</pose>
      <link name="platform">
        <!-- Platform top -->
        <visual name="top"><pose>0 0 0.41 0 0 0</pose><geometry><box><size>0.50 0.60 0.02</size></box></geometry>
          <material><ambient>0.2 0.5 0.7 1</ambient><diffuse>0.25 0.55 0.75 1</diffuse></material></visual>
        <collision name="topc"><pose>0 0 0.41 0 0 0</pose><geometry><box><size>0.50 0.60 0.02</size></box></geometry></collision>
        <!-- 4 legs -->
        <visual name="leg1"><pose>0.20 0.27 0.20 0 0 0</pose><geometry><box><size>0.03 0.03 0.40</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="leg1c"><pose>0.20 0.27 0.20 0 0 0</pose><geometry><box><size>0.03 0.03 0.40</size></box></geometry></collision>
        <visual name="leg2"><pose>0.20 -0.27 0.20 0 0 0</pose><geometry><box><size>0.03 0.03 0.40</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="leg2c"><pose>0.20 -0.27 0.20 0 0 0</pose><geometry><box><size>0.03 0.03 0.40</size></box></geometry></collision>
        <visual name="leg3"><pose>-0.20 0.27 0.20 0 0 0</pose><geometry><box><size>0.03 0.03 0.40</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material></visual>
        <collision name="leg3c"><pose>-0.20 0.27 0.20 0 0 0</pose><geometry><box><size>0.03 0.03 0.40</size></box></geometry></collision>
        <visual name="leg4"><pose>-0.20 -0.27 0.20 0 0 0</pose><geometry><box><size>0.03 0.03 0.40</size></box></geometry>
