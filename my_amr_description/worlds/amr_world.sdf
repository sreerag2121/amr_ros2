<?xml version="1.0"?>
<sdf version="1.8">
  <world name="amr_world">

    <physics name="physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-contact-system"
            name="ignition::gazebo::systems::Contact"/>

    <!-- ===== LIGHTING ===== -->
    <light type="directional" name="sun">
      <pose>0 0 20 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
    <light type="point" name="lamp_1">
      <pose>0 0 7 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="lamp_2">
      <pose>8 0 7 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="lamp_3">
      <pose>-8 0 7 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>25</range><constant>0.4</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- ===== FLOOR ===== -->
    <model name="floor">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 20 0.02</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>30 20 0.02</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.52 1</ambient>
            <diffuse>0.55 0.55 0.52 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== WALLS ===== -->
    <model name="wall_north">
      <static>true</static><pose>0 10 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 0.2 5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>30 0.2 5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -10 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>30 0.2 5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>30 0.2 5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>15 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 20 5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 20 5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-15 0 2.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 20 5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 20 5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material></visual>
      </link>
    </model>

    <!-- =================================================================
         WAREHOUSE RACK MACRO EXPLANATION:
         Each rack = 4 vertical poles + 3 shelf levels + horizontal beams
         Pole: 0.05x0.05 x 2.4m tall (steel grey)
         Shelf levels at z=0.60, 1.20, 1.80 (orange beams like real racks)
         Rack footprint: 1.2m wide x 0.6m deep
         Legs at x=±0.55, y=±0.25
         Robot clearance: legs are only 0.05m wide — robot drives between them
         Rack is STATIC (robot pushes the movable shelf underneath it)
    ================================================================= -->

    <!-- ========== ROW 1 (x = -10) — 4 racks along y axis ========== -->

    <model name="rack_1_1">
      <static>true</static><pose>-10 -6 0 0 0 0</pose>
      <link name="link">
        <!-- 4 vertical poles -->
        <visual name="p1"><pose>0.55 0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <collision name="p1c"><pose>0.55 0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry></collision>
        <visual name="p2"><pose>0.55 -0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <collision name="p2c"><pose>0.55 -0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry></collision>
        <visual name="p3"><pose>-0.55 0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <collision name="p3c"><pose>-0.55 0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry></collision>
        <visual name="p4"><pose>-0.55 -0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry><material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <collision name="p4c"><pose>-0.55 -0.25 1.2 0 0 0</pose><geometry><box><size>0.05 0.05 2.4</size></box></geometry></collision>
        <!-- shelf level 1 — two orange beams at z=0.60 -->
        <visual name="b1l"><pose>0 0.25 0.60 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material></visual>
        <collision name="b1lc"><pose>0 0.25 0.60 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry></collision>
        <visual name="b1r"><pose>0 -0.25 0.60 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material></visual>
        <collision name="b1rc"><pose>0 -0.25 0.60 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry></collision>
        <!-- shelf level 2 — z=1.20 -->
        <visual name="b2l"><pose>0 0.25 1.20 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material></visual>
        <collision name="b2lc"><pose>0 0.25 1.20 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry></collision>
        <visual name="b2r"><pose>0 -0.25 1.20 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material></visual>
        <collision name="b2rc"><pose>0 -0.25 1.20 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry></collision>
        <!-- shelf level 3 — z=1.80 -->
        <visual name="b3l"><pose>0 0.25 1.80 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material></visual>
        <collision name="b3lc"><pose>0 0.25 1.80 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry></collision>
        <visual name="b3r"><pose>0 -0.25 1.80 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry><material><ambient>0.85 0.35 0.05 1</ambient><diffuse>0.85 0.35 0.05 1</diffuse></material></visual>
        <collision name="b3rc"><pose>0 -0.25 1.80 0 0 0</pose><geometry><box><size>1.15 0.05 0.04</size></box></geometry></collision>
        <!-- cross brace -->
        <visual name="brace"><pose>0 0 1.2 0 0 0</pose><geometry><box><size>1.15 0.02 2.0</size></box></geometry><material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

