<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="default">
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.3 0.3 0.3 1.0</background>
      <shadows>false</shadows>
    </scene>
    <include>
  <uri>model://pickup_zone_decal</uri>
  <pose>2.4 1.0 0.0 0 0 -2.9</pose>
</include>
<include>
  <uri>model://storage_zone_decal</uri>
  <pose>-4.3 6 0 0 0 -1.10</pose>
</include>
<include>
  <uri>model://parking_zone_decal</uri>
  <pose>-5 -8 0 0 0 1</pose>
</include>

        <model name="aws_robomaker_warehouse_WallB_01_001">
        <include>
            <uri>model://aws_robomaker_warehouse_WallB_01</uri>
        </include>
        <pose frame="">0.0 0.0 0 0 0 0</pose>
