    <model name="aws_robomaker_warehouse_ClutteringA_01">
        <include>
            <uri>model://aws_robomaker_warehouse_ClutteringA_01</uri>
        </include>
        <pose frame="">-0.84 2.14 0 0 0 0</pose>
	</model>
      <model name="aws_robomaker_warehouse_ClutteringC_01">
        <include>
            <uri>model://aws_robomaker_warehouse_ClutteringC_01</uri>
